# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the example env file
!.env.example

# optional Strapi CMS (strapi/) runtime + build output
/strapi/node_modules/
/strapi/.tmp/
/strapi/.cache/
/strapi/.strapi/
/strapi/.strapi-updater.json
/strapi/dist/
/strapi/build/
/strapi/exports/
/strapi/*.cache
